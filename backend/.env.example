# Copy to .env (git-ignored, chmod 600) for local development. Production injects env vars.
RELAXAI__ENVIRONMENT=local
RELAXAI__FIRM_ID=frm_local
RELAXAI__DB__URL=postgresql+psycopg://relaxai:CHANGE_ME@localhost:5432/relaxai
RELAXAI__CRYPTO__CURSOR_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_32_PLUS_CHARS
RELAXAI__TELEMETRY__LOG_LEVEL=INFO

# Tests: a dedicated, disposable database (tests migrate it and roll back every test).
# TEST_DATABASE_URL=postgresql+psycopg://relaxai:CHANGE_ME@localhost:5432/relaxai_test
