{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "allowedTransitions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Allowedtransitions"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "current": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Authoritative resource on VERSION_CONFLICT, CHAT_SCOPE_LOCKED, UNDO_EXPIRED, REVIEW_ALREADY_RESOLVED.",
            "title": "Current"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryAfterSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retryafterseconds"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "MALFORMED_REQUEST",
          "UNAUTHENTICATED",
          "ACCOUNT_NOT_ACTIVATED",
          "CAPABILITY_DENIED",
          "GOVERNANCE_ONLY",
          "NOT_AVAILABLE",
          "VERSION_CONFLICT",
          "PROJECT_READ_ONLY",
          "INVALID_TRANSITION",
          "FINAL_ADMINISTRATOR",
          "FINAL_FIRM_MANAGER",
          "CHAT_SCOPE_LOCKED",
          "REVIEW_ALREADY_RESOLVED",
          "UNDO_EXPIRED",
          "ALREADY_EXISTS",
          "OPERATION_NOT_DISMISSIBLE",
          "ARCHIVAL_NOT_CANDIDATE",
          "CONNECTOR_CONSENT_REQUIRED",
          "CONNECTOR_NOT_OWNER",
          "PLANNER_NOT_CONNECTED",
          "PREVIEW_STALE",
          "FILE_TOO_LARGE",
          "UNSUPPORTED_FORMAT",
          "VALIDATION_FAILED",
          "SCOPE_INVALID",
          "CONFIRMATION_MISMATCH",
          "REASON_REQUIRED",
          "REASON_CONTAINS_PERSONAL_DATA",
          "ASSIGNEE_INELIGIBLE",
          "VISIBILITY_CONSTRAINT",
          "IDEMPOTENCY_KEY_REUSED",
          "ACTIVATION_DOMAIN_NOT_APPROVED",
          "EMAIL_NOT_VERIFIED",
          "INVITATION_INVALID",
          "INVITATION_EMAIL_MISMATCH",
          "PRECONDITION_REQUIRED",
          "RATE_LIMITED",
          "RETRIEVAL_UNAVAILABLE",
          "INDEX_REBUILDING",
          "UPSTREAM_UNAVAILABLE",
          "QUOTA_EXCEEDED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HaltedWorkView": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "count"
        ],
        "title": "HaltedWorkView",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LastBackup": {
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "verifiedRestoreAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verifiedrestoreat"
          }
        },
        "required": [
          "at"
        ],
        "title": "LastBackup",
        "type": "object"
      },
      "Meter": {
        "enum": [
          "AiTokensIn",
          "AiTokensOut",
          "EmbeddingTokens",
          "OcrPages",
          "BlobBytes"
        ],
        "title": "Meter",
        "type": "string"
      },
      "MeterUsageView": {
        "properties": {
          "estimatedEur": {
            "title": "Estimatedeur",
            "type": "number"
          },
          "meter": {
            "$ref": "#/components/schemas/Meter"
          },
          "quota": {
            "title": "Quota",
            "type": "integer"
          },
          "used": {
            "title": "Used",
            "type": "integer"
          }
        },
        "required": [
          "meter",
          "used",
          "quota",
          "estimatedEur"
        ],
        "title": "MeterUsageView",
        "type": "object"
      },
      "OperatorHealth": {
        "description": "Contract §13 ``/operator/health``. ``degraded`` is true while telemetry delivery is off.",
        "properties": {
          "degraded": {
            "title": "Degraded",
            "type": "boolean"
          },
          "lastBackup": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastBackup"
              },
              {
                "type": "null"
              }
            ]
          },
          "projectionLag": {
            "items": {
              "$ref": "#/components/schemas/ProjectionLag"
            },
            "title": "Projectionlag",
            "type": "array"
          },
          "queue": {
            "items": {
              "$ref": "#/components/schemas/QueueHealth"
            },
            "title": "Queue",
            "type": "array"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceHealth"
            },
            "title": "Services",
            "type": "array"
          }
        },
        "required": [
          "services",
          "queue",
          "projectionLag",
          "lastBackup",
          "degraded"
        ],
        "title": "OperatorHealth",
        "type": "object"
      },
      "OperatorUsage": {
        "properties": {
          "haltedWork": {
            "items": {
              "$ref": "#/components/schemas/HaltedWorkView"
            },
            "title": "Haltedwork",
            "type": "array"
          },
          "meters": {
            "items": {
              "$ref": "#/components/schemas/MeterUsageView"
            },
            "title": "Meters",
            "type": "array"
          },
          "period": {
            "title": "Period",
            "type": "string"
          },
          "planningCeilingsEur": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Planningceilingseur",
            "type": "object"
          }
        },
        "required": [
          "period",
          "meters",
          "haltedWork",
          "planningCeilingsEur"
        ],
        "title": "OperatorUsage",
        "type": "object"
      },
      "ProbeAccepted": {
        "properties": {
          "jobId": {
            "title": "Jobid",
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ],
        "title": "ProbeAccepted",
        "type": "object"
      },
      "ProbeRequest": {
        "additionalProperties": false,
        "properties": {
          "stepDelayMs": {
            "default": 500,
            "title": "Stepdelayms",
            "type": "integer"
          },
          "steps": {
            "default": 3,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "ProbeRequest",
        "type": "object"
      },
      "ProjectionLag": {
        "properties": {
          "lagSeconds": {
            "title": "Lagseconds",
            "type": "number"
          },
          "projectId": {
            "title": "Projectid",
            "type": "string"
          }
        },
        "required": [
          "projectId",
          "lagSeconds"
        ],
        "title": "ProjectionLag",
        "type": "object"
      },
      "QueueHealth": {
        "properties": {
          "depth": {
            "title": "Depth",
            "type": "integer"
          },
          "failed24h": {
            "title": "Failed24H",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "oldestAgeSeconds": {
            "title": "Oldestageseconds",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "depth",
          "oldestAgeSeconds",
          "failed24h"
        ],
        "title": "QueueHealth",
        "type": "object"
      },
      "QuotaChange": {
        "additionalProperties": false,
        "properties": {
          "quota": {
            "title": "Quota",
            "type": "integer"
          }
        },
        "required": [
          "quota"
        ],
        "title": "QuotaChange",
        "type": "object"
      },
      "QuotaChanged": {
        "properties": {
          "meter": {
            "$ref": "#/components/schemas/Meter"
          },
          "quota": {
            "title": "Quota",
            "type": "integer"
          }
        },
        "required": [
          "meter",
          "quota"
        ],
        "title": "QuotaChanged",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "migrations": {
            "enum": [
              "ok",
              "pending",
              "unknown"
            ],
            "title": "Migrations",
            "type": "string"
          }
        },
        "required": [
          "database",
          "migrations"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessStatus": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessStatus",
        "type": "object"
      },
      "ServiceHealth": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "Ok",
              "Degraded",
              "Unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ServiceHealth",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Bootstrap operator token (until T03)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RelaxAI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/operator/health": {
      "get": {
        "operationId": "getOperatorHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Operator Health",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/v1/operator/jobs/probe": {
      "post": {
        "description": "Enqueue a harmless job that reports progress; watching it run proves the worker loop.\n\n``relaxai-admin jobs probe`` calls this. Remove it once T32's job list exists.",
        "operationId": "probeWorkers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProbeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Probe Workers",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/v1/operator/quotas/{meter}": {
      "put": {
        "operationId": "setOperatorQuota",
        "parameters": [
          {
            "in": "path",
            "name": "meter",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Meter"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaChanged"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Set Operator Quota",
        "tags": [
          "operator"
        ]
      }
    },
    "/api/v1/operator/usage": {
      "get": {
        "operationId": "getOperatorUsage",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorUsage"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error envelope (contract §2)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Operator Usage",
        "tags": [
          "operator"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "The process is alive. Never touches dependencies.",
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "The database is reachable and the Alembic head is applied.",
        "operationId": "getReadyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
